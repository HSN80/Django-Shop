# Email and SMTP settings
EMAIL_HOST = # your email host e.g:'smtp.gmail.com'
EMAIL_USE_TLS = # if your host supports TLS, set this as True
EMAIL_PORT = # your host port
EMAIL_HOST_USER = # your username email-id e.g: test@example.com
EMAIL_HOST_PASSWORD = # your host password
DEFAULT_FROM_EMAIL = # similar to  EMAIL_HOST_USER
ZIBAL_MERCHANT = # your actual Zibal Merchant-id, to use sandbox: zibal
SITE_ID = # Id of the Site entry
SECRET_KEY = # a strong key for cryptographic signing and ensure the integrity of sessions and cookies.
DEBUG = # if your in production, keep this False
ALLOWED_HOSTS = # your domain